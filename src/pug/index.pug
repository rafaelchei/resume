                            li.skill-tag .NET / .NET Core
                            li.skill-tag React
                            li.skill-tag TypeScript
                            li.skill-tag JavaScript
                            li.skill-tag Java
                            li.skill-tag SQL
                            li.skill-tag WCF / REST APIs

                    .skill-group.mb-4
                        .subheading.mb-3 Cloud & DevOps
                        ul.skill-tags
                            li.skill-tag Microsoft Azure
                            li.skill-tag AWS
                            li.skill-tag Azure DevOps
                            li.skill-tag GitHub Actions
