doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Rafael Chei — Staff Software Engineer with 20+ years of experience in .NET, C#, React/TypeScript, cloud infrastructure (Azure, AWS), and AI/RAG applications. View my experience, certifications, and skills.')
        meta(name='author', content='Rafael Chei')
        meta(name='keywords', content='Rafael Chei, Software Engineer, .NET Developer, C# Developer, React, Azure, AWS, Cloud Engineer, RAG, AI Engineer, Resume, CV')
        meta(name='theme-color', content='#38bd6b')

        title Rafael Chei — Staff Software Engineer | Resume

        link(rel='canonical', href='https://chei.dev/')

        // Open Graph / social preview
        meta(property='og:type', content='profile')
        meta(property='og:title', content='Rafael Chei — Staff Software Engineer')
        meta(property='og:description', content='20+ years of experience designing, developing, and scaling applications in cloud, mobile, and AI-powered environments.')
        meta(property='og:image', content='assets/img/preview.png')
        meta(property='og:url', content='https://chei.dev/')

        link(rel='icon', type='image/x-icon', href='assets/img/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

        // Structured data for search engines (schema.org Person)
        script(type='application/ld+json').
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Rafael Chei",
                "jobTitle": "Staff Software Engineer",
                "url": "https://chei.dev/",
                "email": "mailto:faelchei@gmail.com",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "Oakland",
                    "addressRegion": "FL",
                    "addressCountry": "US"
                },
                "sameAs": [
                    "https://www.linkedin.com/in/rafaelchei/"
                ]
            }

    body#page-top

        // Navigation
        nav#sideNav.navbar.navbar-expand-lg.navbar-dark.bg-primary.fixed-top
            a.navbar-brand.js-scroll-trigger(href='#page-top')
                span.d-block.d-lg-none Rafael Chei
                span.d-none.d-lg-block
                    img.img-fluid.img-profile.rounded-circle.mx-auto.mb-2(src='assets/img/profile.jpg', alt='Rafael Chei')
            button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                span.navbar-toggler-icon
            #navbarResponsive.collapse.navbar-collapse
                ul.navbar-nav
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#about') About
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#experience') Experience
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#education') Education
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#skills') Skills
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#awards') Certifications

        // Page Content
        .container-fluid.p-0

            // About
            section#about.resume-section
                .resume-section-content
                    h1.mb-0
                        | Rafael
                        span.text-primary Chei
                    .tagline.mb-3 Staff Software Engineer
                    .subheading.contact-line.mb-5
                        span.contact-item
                            i.fas.fa-map-marker-alt
                            |  Oakland, FL
                        span.contact-item
                            a(href='mailto:faelchei@gmail.com')
                                i.fas.fa-envelope
                                |  faelchei@gmail.com
                        span.contact-item
                            a(href='https://chei.dev/', target='_blank', rel='noopener noreferrer')
                                i.fas.fa-globe
                                |  chei.dev
                    p.lead.mb-4
                        | Experienced Staff Software Engineer with 20+ years of experience in designing, developing, and scaling applications in cloud and mobile environments. Extensive experience developing complex systems, improving technical workflows, and contributing to cross-functional projects. Strong background in .NET, cloud infrastructure, DevOps, and modern web/mobile technologies.
                    .d-flex.align-items-center.flex-wrap.gap-3
                        .social-icons
                            a.social-icon(href='https://www.linkedin.com/in/rafaelchei/', target='_blank', rel='noopener noreferrer', aria-label='LinkedIn')
                                i.fab.fa-linkedin-in
                        button#printResume.btn.btn-outline-primary(type='button')
                            i.fas.fa-file-pdf.me-2
                            | Download / Print Resume

            hr.m-0

            // Experience
            section#experience.resume-section
               .resume-section-content
                    h2.mb-5 Experience

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Staff Software Engineer
                            .subheading.mb-3 Genius SIS, Inc. — Remote (HQ: Plantation, FL)
                            ul.bullet-list
                                li Migrated a legacy ASP.NET application to .NET 9 Web API and React, improving performance, scalability, and code maintainability.
                                li Created a Retrieval-Augmented Generation (RAG) AI application leveraging Genius product documentation to enhance information retrieval and user support.
                                li Trained a custom AI model to accurately extract invoice data from PDF and image documents, improving processing automation.
                        .flex-shrink-0
                            span.text-primary Jun 2022 - Present

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Senior Software Engineer
                            .subheading.mb-3 Genius SIS, Inc. — Plantation, FL
                            ul.bullet-list
                                li Developed mission-critical SIS features and APIs; integrated third-party platforms.
                                li Modernized the frontend using React and TypeScript; improved UI performance and accessibility.
                                li Introduced Hangfire to handle background processing, preventing web application freezes caused by data-intensive operations.
                        .flex-shrink-0
                            span.text-primary Mar 2018 - May 2022

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Mobile Platform Specialist (iOS)
                            .subheading.mb-3 Banco (Digio) — São Paulo, Brazil
                            ul.bullet-list
                                li Led iOS development using Swift and Objective-C for digital banking apps with thousands of users.
                                li Delivered features such as biometric login, push notifications, and secure authentication.
                        .flex-shrink-0
                            span.text-primary Sep 2016 - Mar 2018

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Earlier Engineering Roles (Brazil)
                            .subheading.mb-3 Conductor, Serasa Experian, ILATI, Accentiv, Emphasys
                            ul.bullet-list
                                li Held progressive roles from intern to senior engineer building .NET and mobile apps in fintech and enterprise environments.
                                li Technologies: C#, VB.NET, SQL Server, Objective-C, Swift, ASP.NET, WinForms.
                        .flex-shrink-0
                            span.text-primary 2004 - 2016


            hr.m-0

            // Education
            section#education.resume-section
                .resume-section-content
